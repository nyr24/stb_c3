module stb;

import std::io;

const CUInt DEFAULT    = 0;
const CUInt GREY       = 1;
const CUInt GREY_ALPHA = 2;
const CUInt RGB        = 3;
const CUInt RGB_ALPHA  = 4;

alias StbiUc = char;
alias StbiUs = CUShort;

alias UnnamedPFN1 @private = fn CInt(void* user, ZString data, CInt size);

alias UnnamedPFN2 @private = fn void(void* user, CInt n);

alias UnnamedPFN3 @private = fn CInt(void* user);

struct StbiIoCallbacks
{
	UnnamedPFN1 read;
	UnnamedPFN2 skip;
	UnnamedPFN3 eof;
}

fn StbiUc* load_from_memory(
	StbiUc* buffer,
	CInt len,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_load_from_memory");

fn StbiUc* load_from_callbacks(
	StbiIoCallbacks* clbk,
	void* user,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_load_from_callbacks");

fn StbiUc* load(ZString filename, CInt* x, CInt* y, CInt* channels_in_file, CInt desired_channels) @cname("stbi_load");

fn StbiUc* load_from_file(
	File* f,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_load_from_file");

fn StbiUc* load_gif_from_memory(
	StbiUc* buffer,
	CInt len,
	CInt** delays,
	CInt* x,
	CInt* y,
	CInt* z,
	CInt* comp,
	CInt req_comp
) @cname("stbi_load_gif_from_memory");

fn StbiUs* load_16_from_memory(
	StbiUc* buffer,
	CInt len,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_load_16_from_memory");

fn StbiUs* load_16_from_callbacks(
	StbiIoCallbacks* clbk,
	void* user,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_load_16_from_callbacks");

fn StbiUs* load_16(
	ZString filename,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_load_16");

fn StbiUs* load_from_file_16(
	File* f,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_load_from_file_16");

fn float* loadf_from_memory(
	StbiUc* buffer,
	CInt len,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_loadf_from_memory");

fn float* loadf_from_callbacks(
	StbiIoCallbacks* clbk,
	void* user,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_loadf_from_callbacks");

fn float* loadf(ZString filename, CInt* x, CInt* y, CInt* channels_in_file, CInt desired_channels) @cname("stbi_loadf");

fn float* loadf_from_file(
	File* f,
	CInt* x,
	CInt* y,
	CInt* channels_in_file,
	CInt desired_channels
) @cname("stbi_loadf_from_file");

fn void hdr_to_ldr_gamma(float gamma) @cname("stbi_hdr_to_ldr_gamma");

fn void hdr_to_ldr_scale(float scale) @cname("stbi_hdr_to_ldr_scale");

fn void ldr_to_hdr_gamma(float gamma) @cname("stbi_ldr_to_hdr_gamma");

fn void ldr_to_hdr_scale(float scale) @cname("stbi_ldr_to_hdr_scale");

fn CInt is_hdr_from_callbacks(StbiIoCallbacks* clbk, void* user) @cname("stbi_is_hdr_from_callbacks");

fn CInt is_hdr_from_memory(StbiUc* buffer, CInt len) @cname("stbi_is_hdr_from_memory");

fn CInt is_hdr(ZString filename) @cname("stbi_is_hdr");

fn CInt is_hdr_from_file(File* f) @cname("stbi_is_hdr_from_file");

fn ZString failure_reason() @cname("stbi_failure_reason");

fn void err(ZString x, ZString y) @cname("stbi__err");

fn void image_free(void* retval_from_stbi_load) @cname("stbi_image_free");

fn CInt info_from_memory(StbiUc* buffer, CInt len, CInt* x, CInt* y, CInt* comp) @cname("stbi_info_from_memory");

fn CInt info_from_callbacks(
	StbiIoCallbacks* clbk,
	void* user,
	CInt* x,
	CInt* y,
	CInt* comp
) @cname("stbi_info_from_callbacks");

fn CInt is_16_bit_from_memory(StbiUc* buffer, CInt len) @cname("stbi_is_16_bit_from_memory");

fn CInt is_16_bit_from_callbacks(StbiIoCallbacks* clbk, void* user) @cname("stbi_is_16_bit_from_callbacks");

fn CInt info(ZString filename, CInt* x, CInt* y, CInt* comp) @cname("stbi_info");

fn CInt info_from_file(File* f, CInt* x, CInt* y, CInt* comp) @cname("stbi_info_from_file");

fn CInt is_16_bit(ZString filename) @cname("stbi_is_16_bit");

fn CInt is_16_bit_from_file(File* f) @cname("stbi_is_16_bit_from_file");

fn void set_unpremultiply_on_load(CInt flag_true_if_should_unpremultiply) @cname("stbi_set_unpremultiply_on_load");

fn void convert_iphone_png_to_rgb(CInt flag_true_if_should_convert) @cname("stbi_convert_iphone_png_to_rgb");

fn void set_flip_vertically_on_load(CInt flag_true_if_should_flip) @cname("stbi_set_flip_vertically_on_load");

fn void set_unpremultiply_on_load_thread(
	CInt flag_true_if_should_unpremultiply
) @cname("stbi_set_unpremultiply_on_load_thread");

fn void convert_iphone_png_to_rgb_thread(
	CInt flag_true_if_should_convert
) @cname("stbi_convert_iphone_png_to_rgb_thread");

fn void set_flip_vertically_on_load_thread(
	CInt flag_true_if_should_flip
) @cname("stbi_set_flip_vertically_on_load_thread");

fn ZString zlib_decode_malloc_guesssize(
	ZString buffer,
	CInt len,
	CInt initial_size,
	CInt* outlen
) @cname("stbi_zlib_decode_malloc_guesssize");

fn ZString zlib_decode_malloc_guesssize_headerflag(
	ZString buffer,
	CInt len,
	CInt initial_size,
	CInt* outlen,
	CInt parse_header
) @cname("stbi_zlib_decode_malloc_guesssize_headerflag");

fn ZString zlib_decode_malloc(ZString buffer, CInt len, CInt* outlen) @cname("stbi_zlib_decode_malloc");

fn CInt zlib_decode_buffer(ZString obuffer, CInt olen, ZString ibuffer, CInt ilen) @cname("stbi_zlib_decode_buffer");

fn ZString zlib_decode_noheader_malloc(
	ZString buffer,
	CInt len,
	CInt* outlen
) @cname("stbi_zlib_decode_noheader_malloc");

fn CInt zlib_decode_noheader_buffer(
	ZString obuffer,
	CInt olen,
