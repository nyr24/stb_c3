module stb;

import std::io;

const uint DEFAULT    = 0;
const uint GREY       = 1;
const uint GREY_ALPHA = 2;
const uint RGB        = 3;
const uint RGB_ALPHA  = 4;

alias StbiUc = char;
alias StbiUs = CUShort;

alias UnnamedPFN1 @private = fn int(void* user, ZString data, int size);

alias UnnamedPFN2 @private = fn void(void* user, int n);

alias UnnamedPFN3 @private = fn int(void* user);

struct StbiIoCallbacks
{
	UnnamedPFN1 read;
	UnnamedPFN2 skip;
	UnnamedPFN3 eof;
}

fn StbiUc* load_from_memory(
	StbiUc* buffer,
	int len,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_load_from_memory");

fn StbiUc* load_from_callbacks(
	StbiIoCallbacks* clbk,
	void* user,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_load_from_callbacks");

fn StbiUc* load(ZString filename, int* x, int* y, int* channels_in_file, int desired_channels) @cname("stbi_load");

fn StbiUc* load_from_file(
	File* f,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_load_from_file");

fn StbiUc* load_gif_from_memory(
	StbiUc* buffer,
	int len,
	int** delays,
	int* x,
	int* y,
	int* z,
	int* comp,
	int req_comp
) @cname("stbi_load_gif_from_memory");

fn StbiUs* load_16_from_memory(
	StbiUc* buffer,
	int len,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_load_16_from_memory");

fn StbiUs* load_16_from_callbacks(
	StbiIoCallbacks* clbk,
	void* user,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_load_16_from_callbacks");

fn StbiUs* load_16(
	ZString filename,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_load_16");

fn StbiUs* load_from_file_16(
	File* f,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_load_from_file_16");

fn float* loadf_from_memory(
	StbiUc* buffer,
	int len,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_loadf_from_memory");

fn float* loadf_from_callbacks(
	StbiIoCallbacks* clbk,
	void* user,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_loadf_from_callbacks");

fn float* loadf(ZString filename, int* x, int* y, int* channels_in_file, int desired_channels) @cname("stbi_loadf");

fn float* loadf_from_file(
	File* f,
	int* x,
	int* y,
	int* channels_in_file,
	int desired_channels
) @cname("stbi_loadf_from_file");

fn void hdr_to_ldr_gamma(float gamma) @cname("stbi_hdr_to_ldr_gamma");

fn void hdr_to_ldr_scale(float scale) @cname("stbi_hdr_to_ldr_scale");

fn void ldr_to_hdr_gamma(float gamma) @cname("stbi_ldr_to_hdr_gamma");

fn void ldr_to_hdr_scale(float scale) @cname("stbi_ldr_to_hdr_scale");

fn int is_hdr_from_callbacks(StbiIoCallbacks* clbk, void* user) @cname("stbi_is_hdr_from_callbacks");

fn int is_hdr_from_memory(StbiUc* buffer, int len) @cname("stbi_is_hdr_from_memory");

fn int is_hdr(ZString filename) @cname("stbi_is_hdr");

fn int is_hdr_from_file(File* f) @cname("stbi_is_hdr_from_file");

fn ZString failure_reason() @cname("stbi_failure_reason");

fn void err(ZString x, ZString y) @cname("stbi__err");

fn void image_free(void* retval_from_stbi_load) @cname("stbi_image_free");

fn int info_from_memory(StbiUc* buffer, int len, int* x, int* y, int* comp) @cname("stbi_info_from_memory");

fn int info_from_callbacks(
	StbiIoCallbacks* clbk,
	void* user,
	int* x,
	int* y,
	int* comp
) @cname("stbi_info_from_callbacks");

fn int is_16_bit_from_memory(StbiUc* buffer, int len) @cname("stbi_is_16_bit_from_memory");

fn int is_16_bit_from_callbacks(StbiIoCallbacks* clbk, void* user) @cname("stbi_is_16_bit_from_callbacks");

fn int info(ZString filename, int* x, int* y, int* comp) @cname("stbi_info");

fn int info_from_file(File* f, int* x, int* y, int* comp) @cname("stbi_info_from_file");

fn int is_16_bit(ZString filename) @cname("stbi_is_16_bit");

fn int is_16_bit_from_file(File* f) @cname("stbi_is_16_bit_from_file");

fn void set_unpremultiply_on_load(int flag_true_if_should_unpremultiply) @cname("stbi_set_unpremultiply_on_load");

fn void convert_iphone_png_to_rgb(int flag_true_if_should_convert) @cname("stbi_convert_iphone_png_to_rgb");

fn void set_flip_vertically_on_load(int flag_true_if_should_flip) @cname("stbi_set_flip_vertically_on_load");

fn void set_unpremultiply_on_load_thread(
	int flag_true_if_should_unpremultiply
) @cname("stbi_set_unpremultiply_on_load_thread");

fn void convert_iphone_png_to_rgb_thread(
	int flag_true_if_should_convert
) @cname("stbi_convert_iphone_png_to_rgb_thread");

fn void set_flip_vertically_on_load_thread(
	int flag_true_if_should_flip
) @cname("stbi_set_flip_vertically_on_load_thread");

fn ZString zlib_decode_malloc_guesssize(
	ZString buffer,
	int len,
	int initial_size,
	int* outlen
) @cname("stbi_zlib_decode_malloc_guesssize");

fn ZString zlib_decode_malloc_guesssize_headerflag(
	ZString buffer,
	int len,
	int initial_size,
	int* outlen,
	int parse_header
) @cname("stbi_zlib_decode_malloc_guesssize_headerflag");

fn ZString zlib_decode_malloc(ZString buffer, int len, int* outlen) @cname("stbi_zlib_decode_malloc");

fn int zlib_decode_buffer(ZString obuffer, int olen, ZString ibuffer, int ilen) @cname("stbi_zlib_decode_buffer");

fn ZString zlib_decode_noheader_malloc(
	ZString buffer,
	int len,
	int* outlen
) @cname("stbi_zlib_decode_noheader_malloc");

fn int zlib_decode_noheader_buffer(
